# Supabase 프로젝트 → Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ★ 절대 클라이언트에 노출 금지. 서버 라우트에서만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# 크론 라우트 보호용. 아무 긴 문자열이나.
CRON_SECRET=change-me-to-something-long

# 오늘 배포 확인용 스위치.
# true면: 하룻밤 숙성을 건너뛰고, 뽑히자마자 즉시 공개된다.
# 배포 확인이 끝나면 false로 바꿀 것.
INSTANT_MODE=true
